							"typeProperties": {
								"on": {
									"value": "@if(less(int(item().Year), 2022), 'Pre-2022',\n    if(lessOrEquals(int(item().Year), 2024), \n                            'Sales 2022-Current_Year',\n        'Current_Year'    \n    ))\n\n",
									"type": "Expression"
								},
								"cases": [
									{
										"value": "Pre-2022",

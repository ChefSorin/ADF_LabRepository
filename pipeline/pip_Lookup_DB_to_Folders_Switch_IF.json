						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "ds_AzureSqlTable_SalesDetails",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},

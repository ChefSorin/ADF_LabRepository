{
	"name": "pip_Delete_Big_Files",
	"properties": {
		"description": "In work",
		"activities": [
			{
				"name": "Get Metadata RAW Folder",
				"description": "Gets Metadata from RAW folder ",
				"type": "GetMetadata",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "ds_raw_dir_module6",
						"type": "DatasetReference"
					},
					"fieldList": [
						"exists",
						"lastModified",
						"childItems"
					],
					"storeSettings": {
						"type": "AzureBlobStorageReadSettings",
						"recursive": true,
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "DelimitedTextReadSettings"
					}
				}
			},
			{
				"name": "ForEach File in Folder RAW",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Get Metadata RAW Folder",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Get Metadata RAW Folder').output.childItems",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "Get Metadata File",
							"type": "GetMetadata",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"dataset": {
									"referenceName": "ds_raw_indiv_folder",
									"type": "DatasetReference",
									"parameters": {
										"P_indiv_file": {
											"value": "@item().name    ",
											"type": "Expression"
										}
									}
								},
								"fieldList": [
									"columnCount",
									"size",
									"lastModified",
									"structure"
								],
								"storeSettings": {
									"type": "AzureBlobStorageReadSettings",
									"recursive": true,
									"enablePartitionDiscovery": false
								},
								"formatSettings": {
									"type": "DelimitedTextReadSettings"
								}
							}
						},
						{
							"name": "If File Size",
							"type": "IfCondition",
							"dependsOn": [
								{
									"activity": "Get Metadata File",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"expression": {
									"value": "@greater(activity('Get Metadata File').output.size, 150)",
									"type": "Expression"
								},
								"ifFalseActivities": [
									{
										"name": "Delete Files Bigger then limit",
										"type": "Delete",
										"dependsOn": [],
										"policy": {
											"timeout": "0.12:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"dataset": {
												"referenceName": "ds_raw_indiv_folder",
												"type": "DatasetReference",
												"parameters": {
													"P_indiv_file": {
														"value": "@item().name",
														"type": "Expression"
													}
												}
											},
											"logStorageSettings": {
												"linkedServiceName": {
													"referenceName": "ls_raw_blab",
													"type": "LinkedServiceReference"
												},
												"path": "pilogs"
											},
											"enableLogging": true,
											"storeSettings": {
												"type": "AzureBlobStorageReadSettings",
												"recursive": true,
												"enablePartitionDiscovery": false
											}
										}
									}
								]
							}
						}
					]
				}
			}
		],
		"annotations": [],
		"lastPublishTime": "2026-02-08T12:48:03Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}